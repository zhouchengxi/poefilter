Hide # 全局设置 - 装备 - 白色装备
    Rarity Normal
    Class "Amulets" "Rings" "Belts" "Gloves" "Boots" "Helmets" "Body Armours" "Quivers" "Claws" "Daggers" "Wands" "One Hand Axes" "One Hand Maces" "One Hand Swords" "Sceptres" "Staves" "Bows" "Two Hand Axes" "Two Hand Maces" "Two Hand Swords" "Shields" "Spears" "Flails" "Quarterstaves" "Crossbows" "Traps" "Foci" "Bucklers" "Talismans" 
    SetFontSize 30
    DisableDropSound 

Show # 全局设置 - 剩余未匹配物品
    SetTextColor 255 255 255 
    SetBackgroundColor 100 220 145 
    SetBorderColor 0 0 0 0 
    SetFontSize 45
    MinimapIcon 1 Pink Star 
    PlayEffect Pink
    CustomAlertSound "音效\过滤该更新了.mp3" 300
    DisableDropSound 

